{
  "name": "ethical-world",
  "productName": "Ethical World",
  "description": "Local-first knowledge workspace with AI-assisted notes and cybersecurity workflows.",
  "author": "patrikdjasnik-eng",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "main": "electron/main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/patrikdjasnik-eng/ethical-world-.git"
  },
  "scripts": {
    "dev": "vite",
    "desktop:dev": "concurrently -k -n UI,DESKTOP \"vite --host 127.0.0.1\" \"wait-on http-get://127.0.0.1:5173 && electron electron/main.cjs\"",
    "build": "tsc -p tsconfig.json && vite build",
    "verify": "npm test && npm run test:electron && npm run build",
    "desktop:package": "npm run build && electron-forge package",
    "desktop:make": "npm run build && electron-forge make",
    "desktop:publish": "npm run verify && electron-forge publish",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "test": "vitest run",
    "test:watch": "vitest",
    "desktop:test-install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-desktop-install.ps1",
    "desktop:test-install:launch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-desktop-install.ps1 -Launch",
    "desktop:make:squirrel": "npm run build && electron-forge make --targets @electron-forge/maker-squirrel",
    "desktop:make:zip": "npm run build && electron-forge make --targets @electron-forge/maker-zip",
    "desktop:backend:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-backend.ps1",
    "desktop:make:standalone": "npm run desktop:backend:build && npm run desktop:make",
    "desktop:package:standalone": "npm run desktop:backend:build && npm run desktop:package",
    "test:electron": "node --test tests-electron/*.test.cjs",
    "test:backend": "python -m server.test_runner",
    "verify:full": "npm run verify && npm run test:backend",
    "desktop:update": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/update-desktop.ps1",
    "desktop:launcher:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-desktop-launcher.ps1"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "mermaid": "^12.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-force-graph-2d": "^1.29.2",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "update-electron-app": "^3.3.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/publisher-github": "^8.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^10.0.5",
    "electron": "^44.5.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "4.1.11",
    "wait-on": "^9.5.1"
  },
  "allowScripts": {
    "electron-winstaller": true,
    "esbuild": true
  },
  "overrides": {
    "shell-quote": "1.11.0",
    "tinypool": "2.1.2",
    "katex": "0.18.2"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
